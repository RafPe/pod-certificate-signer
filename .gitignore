# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# env file
.env

# Kubeconfig might contain secrets
*.kubeconfig

# Private keys and CA material must never be committed. The dev CA generated
# by `make helm-install` lands under bin/ (already ignored above), but guard
# the key patterns broadly in case one is written elsewhere.
*.pem
*-key.pem
tls.key
ca-key*
