{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "admissionPolicies": {
      "type": "object",
      "properties": {
        "dnsSANValidation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validationActions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["Deny", "Warn", "Audit"]
              },
              "not": {
                "allOf": [
                  { "contains": { "const": "Deny" } },
                  { "contains": { "const": "Warn" } }
                ]
              }
            },
            "namespaceSelector": {
              "type": "object"
            },
            "objectSelector": {
              "type": "object"
            }
          },
          "required": ["enabled", "validationActions", "namespaceSelector", "objectSelector"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
