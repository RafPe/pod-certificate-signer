{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "audit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pod_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^*,]*[*]?$"
          }
        },
        "pod_annotations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^*,]*[*]?$",
            "not": { "const": "*" }
          }
        },
        "max_copied_keys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_value_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_record_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 262144
        },
        "record_supplied_values": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "pod_labels",
        "pod_annotations",
        "max_copied_keys",
        "max_value_length",
        "max_record_bytes",
        "record_supplied_values"
      ],
      "additionalProperties": false
    },
    "admissionPolicies": {
      "type": "object",
      "properties": {
        "dnsSANValidation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validationActions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["Deny", "Warn", "Audit"]
              },
              "not": {
                "allOf": [
                  { "contains": { "const": "Deny" } },
                  { "contains": { "const": "Warn" } }
                ]
              }
            },
            "namespaceSelector": {
              "type": "object"
            },
            "objectSelector": {
              "type": "object"
            }
          },
          "required": ["enabled", "validationActions", "namespaceSelector", "objectSelector"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
